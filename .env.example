# ==============================================================================
# DevPulse (RavenDev) Environment Variables Template
# ==============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. Discord Bot Configuration
# ------------------------------------------------------------------------------
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here

# ------------------------------------------------------------------------------
# 2. Turso (libSQL) Database Configuration
# ------------------------------------------------------------------------------
# Local development default: file:devpulse.db
# Production Turso: libsql://your-db-org.turso.io
TURSO_DATABASE_URL=file:devpulse.db
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 3. Upstash Redis Cache & Distributed Locks
# ------------------------------------------------------------------------------
# Obtain from https://console.upstash.com/
# If omitted, DevPulse automatically defaults to high-performance in-memory cache
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 4. GitHub Integration
# ------------------------------------------------------------------------------
# Optional Personal Access Token to increase GitHub API rate limits (from 60 to 5,000 req/hr)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# ------------------------------------------------------------------------------
# 5. Optional AI Layer (Core operates 100% deterministically without AI)
# ------------------------------------------------------------------------------
# Supported: none | openai | anthropic | gemini
AI_PROVIDER=none
AI_API_KEY=your_ai_api_key_here

# ------------------------------------------------------------------------------
# 6. Security & Rate Limiting
# ------------------------------------------------------------------------------
ENABLE_SECRET_SCANNING=true
RATE_LIMIT_USER_MAX=10
RATE_LIMIT_USER_WINDOW_SEC=10
